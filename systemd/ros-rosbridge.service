[Unit]
Description=NEXOS ROS2 rosbridge websocket (ros_status backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexos
# Adjust the distro if not 'lyrical'
ExecStart=/bin/bash -lc 'source /opt/ros/lyrical/setup.bash && exec ros2 launch rosbridge_server rosbridge_websocket_launch.xml'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
