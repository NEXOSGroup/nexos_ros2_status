[Unit]
Description=NEXOS ros_status web page (static http)
After=network-online.target

[Service]
Type=simple
User=nexos
# Point WorkingDirectory at the deployed web/ folder
WorkingDirectory=/home/nexos/ros_status
ExecStart=/usr/bin/python3 -m http.server 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
