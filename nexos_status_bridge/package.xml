<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nexos_status_bridge</name>
  <version>0.1.0</version>
  <description>NEXOS robot-side status bridge: brings up rosbridge + nexos_status_agent with NEXOS defaults. One endpoint per UGV for the ros_status ground station.</description>
  <maintainer email="office@nexos.group">NEXOS.Group</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>nexos_status_agent</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
