[Unit]
Description=NEXOS status bridge (rosbridge + status agent) for ros_status
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexos
# Adjust the workspace path / distro as needed
ExecStart=/bin/bash -lc 'source /home/nexos/ros2_ws/install/setup.bash && exec ros2 launch nexos_status_bridge status_bridge.launch.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
